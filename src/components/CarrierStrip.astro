---
/**
 * Carrier logo strip. website-scope.md §7 and §9.
 *
 * A carrier with no logo file falls back to a text card rather than a broken
 * image, so the page is never visibly broken.
 *
 * Every logo is lazy-loaded with explicit dimensions, which keeps CLS at zero —
 * the strip is 20+ images and would otherwise be the main layout-shift source.
 *
 * VISUAL POLISH (W5): every card is the SAME height, logos are optically sized
 * to one cap height rather than one bounding box (the wide wordmarks vs square
 * shields problem), and the text fallback matches the logo cards so a missing
 * file never reads as an error.
 */
import { CARRIERS, CARRIER_BY_SLUG } from '../config/carriers.js';

const {
  /** Optional: restrict to these carrier slugs. Omit for all. */
  slugs = null,
  heading = 'Carriers we work with',
} = Astro.props;

const list = (slugs ? slugs.map((s) => CARRIER_BY_SLUG[s]).filter(Boolean) : CARRIERS).slice();
list.sort((a, b) => a.display.localeCompare(b.display));

/**
 * Optical classes: tall/wide marks get a smaller max height than square shields,
 * so the strip reads as one row of equal visual weight. Assign by slug — the
 * shape of each logo is stable.
 */
const TALL_WORDMARKS = new Set([
  'farmers', 'bristol-west', 'safeco', 'travelers', 'national-general',
  'allstate', 'liberty-mutual', 'nationwide', 'the-hartford', 'cna',
  'guideone', 'homeowners-of-america', 'aegis', 'american-modern',
]);
const imgClass = (slug) =>
  TALL_WORDMARKS.has(slug)
    ? 'h-10 aspect-[5/2] max-w-full object-contain'
    : 'h-12 aspect-[5/2] max-w-full object-contain';
---

<div>
  <h3 class="text-base font-bold">{heading}</h3>
  <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      list.map((carrier) =>
        carrier.logo ? (
          <li
            class="group flex h-24 items-center justify-center rounded-lg border border-neutral-200 bg-white p-4 transition hover:border-[var(--color-brand-500)]"
            title={carrier.display}
          >
            <img
              src={`/carriers/${carrier.logo}`}
              alt={`${carrier.display} logo`}
              width="160"
              height="64"
              loading="lazy"
              decoding="async"
              class={imgClass(carrier.slug)}
            />
          </li>
        ) : (
          <li class="flex h-24 items-center justify-center rounded-lg border border-neutral-200 bg-white p-4 text-center text-sm font-semibold text-[var(--color-ink-soft)]">
            {carrier.display}
          </li>
        ),
      )
    }
  </ul>
  <p class="mt-3 text-sm text-[var(--color-ink-muted)]">
    A selection of the carriers we hold appointments with. Ask us for the full
    current list for your specific risk.
  </p>
</div>
