---
/**
 * Icon: one inline SVG set, replacing the old text glyphs (check, diamond,
 * arrows, chevrons). Inline means no request, crisp at every size, and it
 * inherits `currentColor`, so a parent's text colour tints it.
 *
 * Always decorative (`aria-hidden`); put the meaning in nearby text.
 */
const { name, class: className = 'h-5 w-5', stroke = 1.75 } = Astro.props;

/** Each entry is a list of path `d` strings on a 24 x 24 grid. */
const PATHS = {
  check: ['M20 6 9 17l-5-5'],
  'arrow-right': ['M5 12h14', 'm12 5 7 7-7 7'],
  'chevron-down': ['m6 9 6 6 6-6'],
  'chevron-right': ['m9 18 6-6-6-6'],
  plus: ['M12 5v14', 'M5 12h14'],
  phone: [
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z',
  ],
  shield: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
  'shield-check': ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', 'm9 12 2 2 4-4'],
  home: ['M3 11l9-8 9 8', 'M5 10v10h14V10', 'M10 20v-6h4v6'],
  building: ['M4 21V8l8-5 8 5v13', 'M8 12h2M14 12h2M8 16h2M14 16h2'],
  umbrella: ['M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9', 'M12 12v7a2 2 0 0 0 4 0'],
  diamond: ['M12 3 21 12 12 21 3 12z'],
  pin: ['M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z', 'M12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z'],
  clock: ['M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z', 'M12 6v6l4 2'],
};

/** Quote marks and stars read better filled than outlined. */
const FILLED = {
  quote: [
    'M9.5 6C6.5 7 4 9.8 4 13.5V18h6v-6H6.6c.2-2 1.3-3.5 3.4-4.2L9.5 6zm9 0c-3 1-5.5 3.8-5.5 7.5V18h6v-6h-3.4c.2-2 1.3-3.5 3.4-4.2L18.5 6z',
  ],
  star: ['M12 2.5l2.95 6.1 6.7.9-4.9 4.6 1.25 6.6L12 17.4l-6 3.3 1.25-6.6-4.9-4.6 6.7-.9z'],
};

const filled = name in FILLED;
const paths = filled ? FILLED[name] : (PATHS[name] ?? []);
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((d) => <path d={d} />)}
</svg>
