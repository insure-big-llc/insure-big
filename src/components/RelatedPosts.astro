---
/**
 * "From the blog" on a product page: the published posts about this line, so the
 * answer posts and the product page link to each other. Renders nothing when there
 * are no posts for the line. Sits above the FAQ, which stays the last block.
 */
import { publishedPosts } from '../lib/blog-posts.js';

const { service } = Astro.props;
const posts = publishedPosts().filter((p) => p.service === service);
---

{
  posts.length > 0 && (
    <section class="mt-14 rounded-2xl bg-[var(--color-surface-alt)] p-6">
      <h2 class="text-xl">From the blog</h2>
      <ul class="mt-4 space-y-3">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} class="font-semibold underline">{p.title}</a>
            <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{p.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}