---
/**
 * FAQ block.
 *
 * The questions and answers are rendered as real, visible content AND emitted as
 * FAQPage JSON-LD by the page. Google treats FAQ markup whose content is not
 * visible on the page as spam, so these must always be the same array — the page
 * passes `service.faq` to both this component and `faqSchema()`.
 *
 * Uses native <details>/<summary> so it works with JS disabled and is keyboard
 * accessible without extra script. Design pass 2: each question is a soft card
 * that warms when open, the plus rotates into a cross, and the answer glides
 * open where the browser supports animating to auto height.
 */
import Icon from './Icon.astro';

// `heading={null}` drops the title and the top margin, for pages (the home page)
// whose section already carries its own heading.
const { faqs = [], heading = 'Frequently asked questions' } = Astro.props;
---

{
  faqs.length ? (
    <section class={heading ? 'mt-14' : ''}>
      {heading && <h2 class="text-2xl">{heading}</h2>}
      <div class={heading ? 'mt-6 space-y-3' : 'space-y-3'}>
        {faqs.map((faq) => (
          <details class="group card overflow-hidden px-5 transition-colors open:border-[var(--color-brand-300)] open:bg-[var(--color-brand-50)]/40">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3">
              <h3 class="text-base font-bold">{faq.q}</h3>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-50)] text-[var(--color-brand-700)] transition-transform duration-300 group-open:rotate-45">
                <Icon name="plus" class="h-4 w-4" stroke={2.25} />
              </span>
            </summary>
            <div class="pb-5">
              <p class="faq-short prose-page font-semibold text-[var(--color-ink)]">{faq.s}</p>
              <p class="prose-page mt-2 text-[var(--color-ink-soft)]">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  ) : null
}
