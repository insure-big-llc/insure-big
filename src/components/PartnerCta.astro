---
/**
 * The one quote button on a partner product page (device protection, surety
 * bonds, wind and hail, Premium Lock, estate planning, pet, travel, Medicare).
 *
 * THE RULE (6 November 2026): these pages carry no on-site form. The button
 * goes straight to the partner's referral link from src/config/partners.js,
 * opens in a new tab, and is marked rel="sponsored" because it is a paid
 * referral. The disclosure, the highlight and the phone alternative sit under
 * it so the visitor knows exactly where they are going.
 */
import { CONTACT } from '../config/site.js';
import Icon from './Icon.astro';

const {
  partner,
  /** 'card' is the sidebar block; 'inline' is the compact header button. */
  variant = 'card',
  phone = CONTACT.phone,
  phoneHref = CONTACT.phoneHref,
} = Astro.props;

const label = partner.ctaLabel ?? `Get a ${partner.product} quote`;
---

{
  variant === 'inline' ? (
    <a
      href={partner.url}
      class="btn btn-primary"
      target="_blank"
      rel="sponsored noopener noreferrer"
      data-partner-cta
    >
      {label}
      <Icon name="arrow-right" class="h-4 w-4" />
      <span class="sr-only"> (opens {partner.partner} in a new tab)</span>
    </a>
  ) : (
    <section
      id="quote"
      class="rounded-2xl border border-neutral-200 border-t-[3px] border-t-[var(--color-brand-500)] bg-[var(--color-surface-alt)] p-6 shadow-[var(--shadow-soft)] sm:p-8"
    >
      <p class="kicker">{partner.product}</p>
      <h2 class="mt-2 text-2xl">Get your {partner.product} quote</h2>

      {partner.highlight && (
        <p class="mt-3 text-base font-semibold text-[var(--color-brand-700)]">{partner.highlight}</p>
      )}

      <a
        href={partner.url}
        class="btn btn-primary mt-6 w-full sm:w-auto"
        target="_blank"
        rel="sponsored noopener noreferrer"
        data-partner-cta
      >
        {label}
        <Icon name="arrow-right" class="h-4 w-4" />
        <span class="sr-only"> (opens {partner.partner} in a new tab)</span>
      </a>
      <p class="mt-3 text-sm text-[var(--color-ink-muted)]">
        You will finish on {partner.partner}'s secure site. Prefer to talk first? Call{' '}
        <a href={phoneHref} class="font-semibold underline">{phone}</a>.
      </p>

      <p class="mt-5 text-sm leading-relaxed text-[var(--color-ink-soft)]">{partner.disclosure}</p>
      {partner.agentOfRecord === null && (
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
          This is a third-party programme, and their application is theirs. If you would like
          us involved, call us first.
        </p>
      )}
      <p class="mt-4 text-xs text-[var(--color-ink-muted)]">
        <a href="/coverage-partners" class="underline">How our partner programmes work</a>
      </p>
    </section>
  )
}
