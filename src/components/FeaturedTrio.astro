---
/**
 * FeaturedTrio — the homepage's eye-catching highlight (spec 0006, AC-1).
 *
 * Three accent tiles for the services that matter most: Home, Auto, and
 * Business. Each tile reuses the existing service text and links, and the
 * whole block is a single reveal so the page keeps its calm.
 */
import { SERVICES, servicePath } from '../config/services.js';

const trio = [
  { service: SERVICES.find((s) => s.slug === 'home'), chip: 'Most asked about' },
  { service: SERVICES.find((s) => s.slug === 'auto'), chip: 'Bundles save the most' },
  { hub: true, name: 'Business Insurance', blurb: 'General liability, BOPs, commercial auto, workers compensation and industry programmes for the businesses that keep the metro running.', chip: 'Built for local business', path: '/business-insurance' },
];
---

<section class="container-page reveal py-16">
  <p class="font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
    Where most people start
  </p>
  <h2 class="mt-2 text-2xl sm:text-3xl">The big three, covered properly</h2>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      trio.map((item) => (
        <a
          href={item.hub ? item.path : servicePath(item.service)}
          class="accent-tile card-lift group flex min-h-44 flex-col p-6"
        >
          <span class="pill-chip w-fit">{item.chip}</span>
          <span class="mt-4 text-xl font-bold text-[var(--color-ink)] group-hover:underline">
            {item.hub ? item.name : item.service.name}
          </span>
          <span class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            {item.hub ? item.blurb : item.service.blurb}
          </span>
        </a>
      ))
    }
  </div>
</section>
