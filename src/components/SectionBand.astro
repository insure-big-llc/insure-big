---
/**
 * SectionBand: the compact ink band used as the page header on hubs and the
 * other purpose treated pages (about, contact, 404). Design pass 2: layered
 * gradient backdrop, crisp SVG line art on the right (themed per hub, the
 * shield everywhere else) and the gold rule kicker.
 *
 * `art` is a motif name for Art.astro ('home' | 'business' | 'life' |
 * 'specialty' | 'shield'), not an image path.
 *
 * Carries the page's single <h1>; the caller must not render another one.
 */
import Art from './Art.astro';

const { title, kicker = null, art = 'shield' } = Astro.props;
---

<section class="hero-bg relative isolate overflow-hidden text-white">
  <div aria-hidden="true" class="dot-grid absolute inset-0"></div>
  <Art kind={art ?? 'shield'} class="absolute inset-y-0 right-0 hidden h-full w-[70%] lg:block" />
  <div class="container-page relative py-10 lg:py-14">
    <div class="max-w-3xl">
      {kicker && <p class="kicker kicker-on-dark">{kicker}</p>}
      <h1 class="mt-4 text-3xl leading-tight tracking-tight sm:text-4xl lg:text-[2.6rem]">{title}</h1>
      <slot />
    </div>
  </div>
</section>
