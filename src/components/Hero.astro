---
/**
 * Hero: the home page's first screen (design pass 2).
 *
 * Dark ink with a soft gold glow, a hairline dot grid and crisp SVG shield art
 * (all CSS and inline SVG, so nothing is stretched or soft), and the agency's
 * own office photo framed on the right. The photo is a real shot of the team
 * at work, replacing the logo on a white card.
 *
 * Motion is one calm entrance on the supporting pieces (buttons, quote chips,
 * the rating chip) and a slow settle on the photo. The headline and body copy
 * never animate, so the largest paint is never delayed.
 *
 * Props:
 *   headline, supporting   copy from the caller
 *   emphasis               optional word inside the headline to set in gold
 *   photo                  { src, srcset, sizes, alt, width, height } or null
 *   chip                   optional { rating, label } shown on the photo
 *   brand                  fallback logo card when there is no photo
 */
import Art from './Art.astro';
import Stars from './Stars.astro';
import { SITE } from '../config/site.js';

const {
  headline,
  supporting,
  emphasis = null,
  kicker = `${SITE.shortName} — an independent agency`,
  photo = null,
  chip = null,
  brand = false,
} = Astro.props;

const hasSide = Boolean(photo || brand);

/** Splits the headline around the emphasised word, if it is present. */
const parts = emphasis && headline.includes(emphasis) ? headline.split(emphasis) : null;
---

<section class="hero-bg relative isolate overflow-hidden text-white">
  <div aria-hidden="true" class="dot-grid absolute inset-0"></div>
  <Art kind="shield" class="absolute inset-y-0 right-0 hidden h-full w-[78%] opacity-80 lg:block" />

  <div class="container-page relative py-14 sm:py-16 lg:py-24">
    <div class:list={['grid items-center gap-12', hasSide && 'lg:grid-cols-[minmax(0,1fr)_460px]']}>
      <div class="max-w-2xl">
        <p class="kicker kicker-on-dark">{kicker}</p>
        <h1 class="mt-5 text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {
            parts ? (
              <>
                {parts[0]}
                <span class="bg-gradient-to-r from-[var(--color-brand-200)] to-[var(--color-brand-400)] bg-clip-text text-transparent">
                  {emphasis}
                </span>
                {parts[1]}
              </>
            ) : (
              headline
            )
          }
        </h1>
        {supporting && <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">{supporting}</p>}
        <div class="enter mt-8 flex flex-wrap gap-3" style="--enter-delay: 120ms">
          <slot />
        </div>
      </div>

      {
        photo && (
          <div class="relative mx-auto w-full max-w-md lg:max-w-none">
            <div class="photo-frame aspect-[4/3]">
              <img
                src={photo.src}
                srcset={photo.srcset}
                sizes={photo.sizes}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="settle h-full w-full object-cover"
              />
            </div>
            {chip && (
              <div
                class="glass-chip enter absolute -bottom-5 left-5 flex items-center gap-3 rounded-full py-2 pl-4 pr-5 shadow-xl"
                style="--enter-delay: 420ms"
              >
                <Stars class="h-4 w-4" />
                <span class="text-sm font-semibold">
                  {chip.rating} {chip.label}
                </span>
              </div>
            )}
          </div>
        )
      }
      {
        brand && !photo && (
          <div class="mx-auto flex w-full max-w-md items-center justify-center rounded-2xl bg-white p-8 shadow-2xl lg:p-10">
            <img
              src="/images/big-logo.webp"
              alt="Ballentine Insurance Group"
              width="180"
              height="60"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="h-auto w-full max-w-sm object-contain"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
