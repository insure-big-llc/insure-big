---
/**
 * Site header.
 *
 * The current live site's navigation is only "Home · Get a Quote" — the three
 * service pages exist but are unreachable from the menu (website-scope.md §1).
 * This header fixes that: every hub and every service is linked with a real
 * <a href>, so they are crawlable.
 *
 * No JS. The mobile menu uses a <details> element so it works with JS disabled
 * — a crawler that does not execute JS must still see every link.
 *
 * Design pass 2: sticky and frosted on desktop with a scroll tied shadow, an
 * animated gold underline on the current section, and dropdown panels that
 * settle into place. See `.site-header`, `.nav-link` and `.nav-panel` in
 * global.css.
 */
import { HUBS, SPECIALTY_GROUP, SERVICES, servicesByHub } from '../config/services.js';
import { CONTACT, QUOTE_URL } from '../config/site.js';
import Icon from './Icon.astro';

const specialty = SERVICES.filter((s) => s.hub === 'specialty');

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const inSection = (slug) => here === `/${slug}` || here.startsWith(`/${slug}/`);
const is = (path) => here === path;

const linkClass =
  'nav-link flex min-h-11 items-center px-3 py-2 text-sm font-semibold text-[var(--color-ink)] transition-colors hover:text-[var(--color-brand-700)]';
const panelClass = 'nav-panel absolute left-0 top-full z-40 w-72 pt-2';
const panelCard =
  'rounded-xl border border-neutral-200 bg-white p-2 shadow-[var(--shadow-lift)]';
const itemClass =
  'block rounded-lg px-3 py-2 text-sm text-[var(--color-ink-soft)] transition-colors hover:bg-[var(--color-brand-50)] hover:text-[var(--color-ink)]';
---

<header class="site-header border-b border-neutral-200/80">
  <div class="container-page">
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Ballentine Insurance Group — home">
        <img
          src="/images/big-logo.webp"
          alt="Ballentine Insurance Group"
          width="180"
          height="60"
          class="h-12 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            HUBS.map((hub) => (
              <li class="group relative">
                <a
                  href={`/${hub.slug}`}
                  class={linkClass}
                  aria-current={inSection(hub.slug) ? 'page' : undefined}
                >
                  {hub.title}
                </a>
                <div class={panelClass}>
                  <ul class={panelCard}>
                    {servicesByHub(hub.slug).map((s) => (
                      <li>
                        <a href={`/${hub.slug}/${s.slug}`} class={itemClass}>
                          {s.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
          <li class="group relative">
            <a
              href="/specialty/surety-bonds"
              class={linkClass}
              aria-current={inSection('specialty') ? 'page' : undefined}
            >
              Specialty
            </a>
            <div class={panelClass}>
              <ul class={panelCard}>
                {specialty.map((s) => (
                  <li>
                    <a href={`/specialty/${s.slug}`} class={itemClass}>
                      {s.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
          <li>
            <a href="/about" class={linkClass} aria-current={is('/about') ? 'page' : undefined}>
              About
            </a>
          </li>
          <li>
            <a href="/contact" class={linkClass} aria-current={is('/contact') ? 'page' : undefined}>
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={CONTACT.phoneHref} class="btn btn-secondary hidden sm:inline-flex">
          <Icon name="phone" class="h-4 w-4" />
          Call {CONTACT.phone}
        </a>
        <a href={QUOTE_URL} class="btn btn-primary">Get a Quote</a>
      </div>
    </div>

    <!-- Mobile nav: <details> keeps every link in the static HTML, no JS needed. -->
    <details class="group/menu pb-3 lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold shadow-[var(--shadow-soft)]"
      >
        <span>Browse insurance</span>
        <Icon name="chevron-down" class="h-4 w-4 transition-transform duration-300 group-open/menu:rotate-180" />
      </summary>
      <nav aria-label="Mobile" class="mt-2 space-y-2">
        <div class="flex gap-2">
          <a href={CONTACT.phoneHref} class="btn btn-secondary flex-[1.5] whitespace-nowrap px-3 text-sm">Call {CONTACT.phone}</a>
          <a href={QUOTE_URL} class="btn btn-primary flex-1 whitespace-nowrap px-3 text-sm">Get a Quote</a>
        </div>
        {
          HUBS.map((hub) => (
            <details class="group/hub">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded px-1 py-1.5 text-sm font-bold">
                <span>{hub.title}</span>
                <Icon
                  name="chevron-right"
                  class="h-4 w-4 text-[var(--color-brand-700)] transition-transform duration-300 group-open/hub:rotate-90"
                />
              </summary>
              <ul class="ml-2 mt-1 border-l border-neutral-200 pl-2">
                {servicesByHub(hub.slug).map((s) => (
                  <li>
                    <a href={`/${hub.slug}/${s.slug}`} class="block py-1.5 text-sm">
                      {s.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
        <details class="group/hub">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded px-1 py-1.5 text-sm font-bold">
            <span>{SPECIALTY_GROUP.title}</span>
            <Icon
              name="chevron-right"
              class="h-4 w-4 text-[var(--color-brand-700)] transition-transform duration-300 group-open/hub:rotate-90"
            />
          </summary>
          <ul class="ml-2 mt-1 border-l border-neutral-200 pl-2">
            {specialty.map((s) => (
              <li>
                <a href={`/specialty/${s.slug}`} class="block py-1.5 text-sm">
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
        <div class="flex flex-col gap-1 border-t border-neutral-200 pt-3">
          <a href="/about" class="block py-1.5 text-sm font-bold">About</a>
          <a href="/contact" class="block py-1.5 text-sm font-bold">Contact</a>
          <a href="/lees-summit" class="block py-1.5 text-sm">Lee's Summit office</a>
          <a href="/northland" class="block py-1.5 text-sm">Northland office</a>
        </div>
      </nav>
    </details>
  </div>
</header>
