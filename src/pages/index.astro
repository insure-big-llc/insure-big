---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { TEAM } from '../config/team.js';
import FaqBlock from '../components/FaqBlock.astro';
import FeaturedTrio from '../components/FeaturedTrio.astro';
import MarqueeBand from '../components/MarqueeBand.astro';
import { SITE, CONTACT, LOCATIONS } from '../config/site.js';
import { HUBS, SERVICES, SPECIALTY_GROUP, HOME_OFFER_COPY, HOME_FAQ } from '../config/services.js';
import { GOOGLE_REVIEWS, LOCATION_PROFILES, CUSTOMER_REVIEWS } from '../config/reviews.js';
import { webPageSchema, reviewsSchema, faqSchema } from '../lib/schema.js';

/** The hero quote selector. Each choice carries into /get-a-quote. */
const QUOTE_LINES = [
  { key: 'home', label: 'Home' },
  { key: 'auto', label: 'Auto' },
  { key: 'business', label: 'Business' },
  { key: 'life', label: 'Life' },
  { key: 'other', label: 'Other' },
];

const specialties = SERVICES.filter((s) => s.hub === 'specialty');

/** Minimal coverage icons per hub, matching the research pattern of coverage as a menu. */
const HUB_ICONS = {
  'personal-insurance': ['M3 11l9-8 9 8', 'M5 10v10h14V10'],
  'business-insurance': ['M4 21V8l8-5 8 5v13', 'M8 12h2M14 12h2M8 16h2M14 16h2'],
  'life-insurance': ['M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9', 'M12 12v9'],
};

const schema = [
  webPageSchema({
    path: '/',
    title: `${SITE.name} — Insurance in the Kansas City Metro`,
    description: SITE.marketStatement,
  }),
  // Contributes review + aggregateRating to the organization node in BaseLayout.
  reviewsSchema(),
  faqSchema({ faqs: HOME_FAQ, path: '/' }),
];
---

<BaseLayout
  title="Insurance in the Kansas City Metro"
  description="Independent insurance agency in Lee's Summit and Kansas City. Home, auto, business, life and specialty coverage compared across carriers. Call (816) 868-1787."
  path="/"
  schema={schema}
>
  <!-- Hero: the shield art stays background only; the BIG mark anchors the right side. -->
  <Hero
    headline={SITE.tagline}
    supporting={`Tailored insurance solutions to fit you — home, auto, business, life and specialty coverage, compared across 50+ top-rated carriers instead of sold from a single shelf.`}
    brand
  >
    <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
    <a href={CONTACT.phoneHref} class="btn btn-on-dark">Call {CONTACT.phone}</a>
    <p class="basis-full text-base font-semibold text-white/85">{SITE.marketStatement}</p>
    <div class="basis-full">
      <p class="text-sm font-semibold text-white/85">Start your quote:</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {QUOTE_LINES.map((l) => (
          <a
            href={`/get-a-quote?coverage=${l.key}`}
            class="rounded-full border border-white/30 px-4 py-1.5 text-sm font-semibold text-white transition-colors hover:border-[var(--color-brand-400)] hover:text-[var(--color-brand-300)]"
          >
            {l.label} insurance
          </a>
        ))}
      </div>
    </div>
  </Hero>

  <!-- Proof card: overlaps the hero bottom, the counted numbers up top -->
  <div class="container-page relative z-10 -mt-10 lg:-mt-12">
    <div class="proof-edge mx-auto max-w-3xl rounded-xl bg-[var(--color-surface-alt)] p-5 shadow-lg sm:p-6">
      <div class="grid grid-cols-3 divide-x divide-neutral-200 text-center">
        <div class="px-2">
          <p class="flex items-center justify-center gap-1 text-2xl font-bold">
            <span data-count="5.0" data-decimals="1">{GOOGLE_REVIEWS.rating.toFixed(1)}</span>
            <span aria-hidden="true" class="text-base text-[var(--color-brand-600)]">★</span>
          </p>
          <p class="mt-1 text-xs font-semibold text-[var(--color-ink-soft)]">
            Google rating
          </p>
        </div>
        <div class="px-2">
          <p class="text-2xl font-bold"><span data-count="50">50</span>+</p>
          <p class="mt-1 text-xs font-semibold text-[var(--color-ink-soft)]">carriers compared</p>
        </div>
        <div class="px-2">
          <p class="text-xl font-bold">Since 2018</p>
          <p class="mt-1 text-xs font-semibold text-[var(--color-ink-soft)]">serving the metro</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    {
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('[data-count]');
        if (!els.length || reduce) return;
        const io = 'IntersectionObserver' in window
          ? new IntersectionObserver((entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const el = entry.target;
                io.unobserve(el);
                const target = parseFloat(el.dataset.count);
                const decimals = parseInt(el.dataset.decimals || '0', 10);
                const t0 = performance.now();
                const dur = 900;
                const tick = (now) => {
                  const p = Math.min((now - t0) / dur, 1);
                  const eased = 1 - Math.pow(1 - p, 3);
                  el.textContent = (target * eased).toFixed(decimals);
                  if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
              }
            }, { threshold: 0.6 })
          : null;
        for (const el of els) {
          if (io) io.observe(el);
          else el.textContent = el.dataset.count;
        }
      })();
    }
  </script>

  <MarqueeBand />

  <FeaturedTrio />

  <!-- Hubs -->
  <section class="container-page reveal py-16">
    <p class="font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
      Coverage
    </p>
    <h2 class="mt-2 text-2xl sm:text-3xl">What we cover</h2>
    <p class="prose-page mt-3 text-[var(--color-ink-soft)]">
      Every line below has its own page, and every page has a quote form. If you
      don't see what you need, call us — we write coverage well beyond this list.
    </p>

    <div class="reveal-stagger mt-10 grid gap-8 lg:grid-cols-3">
      {
        HUBS.map((hub) => (
          <div class="card-lift group flex flex-col rounded-xl border border-neutral-200 p-6">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-brand-50)] text-[var(--color-brand-700)]"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {HUB_ICONS[hub.slug].map((d) => <path d={d} />)}
              </svg>
            </span>
            <h3 class="mt-4 text-xl">
              <a href={`/${hub.slug}`} class="hover:underline hover:text-[var(--color-brand-700)]">
                {hub.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
              {HOME_OFFER_COPY[hub.slug] ?? hub.blurb}
            </p>
            <ul class="mt-5 space-y-2 text-sm">
              {SERVICES.filter((s) => s.hub === hub.slug).map((s) => (
                <li>
                  <a
                    href={`/${hub.slug}/${s.slug}`}
                    class="text-[var(--color-ink-soft)] hover:underline hover:text-[var(--color-brand-700)]"
                  >
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-auto pt-5 text-sm font-semibold text-[var(--color-brand-700)]">
              <a href={`/${hub.slug}`} class="inline-flex items-center gap-1 hover:underline">
                {SERVICES.filter((s) => s.hub === hub.slug).length} cover types
                <span aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Specialty -->
  <section class="reveal bg-[var(--color-surface-alt)] py-16">
    <div class="container-page">
      <a
        href="/blog/premium-lock-for-auto"
        class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-bold text-[var(--color-brand-700)] ring-1 ring-[var(--color-brand-300)]"
      >
        New: Premium Lock now covers auto
      </a>
      <p class="mt-4 font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
        More ways we help
      </p>
      <h2 class="mt-2 text-2xl sm:text-3xl">{SPECIALTY_GROUP.title}</h2>
      <p class="prose-page mt-3 text-[var(--color-ink-soft)]">{SPECIALTY_GROUP.blurb}</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          specialties.map((s) => (
            <li>
              <a
                href={`/specialty/${s.slug}`}
                class="flex min-h-11 items-center rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm font-semibold hover:underline hover:border-[var(--color-brand-500)]"
              >
                <span aria-hidden="true" class="mr-2 text-[var(--color-brand-600)]">◆</span>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why BIG -->
  <section class="reveal container-page py-16">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
          Why BIG
        </p>
        <h2 class="mt-2 text-2xl sm:text-3xl">Why clients choose BIG</h2>
        <ul class="mt-6 space-y-4 text-[var(--color-ink-soft)]">
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-0.5 text-[var(--color-brand-600)]">✓</span>
            <span>An independent agency representing multiple top-rated insurance companies.</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-0.5 text-[var(--color-brand-600)]">✓</span>
            <span>Personalised recommendations rather than a one-size-fits-all package.</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-0.5 text-[var(--color-brand-600)]">✓</span>
            <span>Annual policy reviews, so your cover keeps pace with your life.</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-0.5 text-[var(--color-brand-600)]">✓</span>
            <span>Claims support from someone who knows you — not a call centre.</span>
          </li>
        </ul>
        <a href="/about" class="btn btn-secondary mt-8">More about us</a>
      </div>

      <div class="rounded-xl border border-neutral-200 bg-white p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-muted)]">
          The people you'll talk to
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-4">
          {TEAM.map((m) => (
            <li class="text-center">
              <img
                src={m.photo}
                alt={m.name}
                width="96"
                height="96"
                loading="lazy"
                class="mx-auto h-20 w-20 rounded-full object-cover ring-2 ring-[var(--color-brand-100)]"
              />
              <p class="mt-2 text-sm font-semibold">{m.name}</p>
              <p class="mt-0.5 text-xs text-[var(--color-ink-muted)]">{m.title}</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm">
          <a href="/about" class="font-semibold underline">Meet the whole team</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Proof: both offices' real ratings, then the featured reviews in full -->
  <section class="reveal container-page py-16">
    <p class="text-center font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
      Proof
    </p>
    <h2 class="mt-2 text-center text-2xl sm:text-3xl">What our clients say</h2>
    <p class="prose-page mx-auto mt-3 max-w-2xl text-center text-[var(--color-ink-soft)]">
      Rated 5.0 on Google at both offices, in their words, unedited.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {
        LOCATIONS.map((loc) => {
          const p = LOCATION_PROFILES[loc.id];
          return (
            <a
              href={loc.mapLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-1.5 text-sm shadow-sm hover:border-[var(--color-brand-500)]"
            >
              <span class="font-bold">{p.rating.toFixed(1)}</span>
              <span aria-hidden="true" class="text-xs text-[var(--color-brand-600)]">★★★★★</span>
              <span class="text-[var(--color-ink-soft)]">
                {p.count} Google reviews · {loc.locality}
              </span>
            </a>
          );
        })
      }
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        LOCATIONS.map((loc) => {
          const p = LOCATION_PROFILES[loc.id];
          const reviews = loc.id === 'lees-summit' ? p.reviews : CUSTOMER_REVIEWS;
          return (
            <section class="rounded-xl bg-[var(--color-surface-alt)] p-6">
              <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg">{loc.name}</h3>
                <a
                  href={loc.mapLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold underline hover:text-[var(--color-brand-700)]"
                >
                  {p.rating.toFixed(1)} ★★★★★ · {p.count} reviews
                </a>
              </header>
              <ul class="mt-5 space-y-4">
                {
                  reviews.slice(0, 3).map((r) => (
                    <li class="rounded-lg border-l-2 border-[var(--color-brand-500)] bg-white p-4">
                      <p aria-hidden="true" class="text-xs text-[var(--color-brand-600)]">
                        ★★★★★
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                        &ldquo;{r.text}&rdquo;
                      </p>
                      <p class="mt-2 text-xs font-semibold">
                        {r.author}
                        <span class="font-normal text-[var(--color-ink-muted)]">
                          {' '}
                          — {r.dateText}
                        </span>
                      </p>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-4 text-sm">
                <a href={`/${loc.slug}`} class="inline-flex min-h-11 items-center rounded px-2 font-semibold underline">
                  Read all {loc.locality} reviews
                </a>
              </p>
            </section>
          );
        })
      }
    </div>
  </section>

  <!-- Quote band -->
  <QuoteBand
    heading="Get your quote compared across carriers"
    copy="One short form, one local team, and quotes from the carriers we would recommend for your risk. No obligation, no single-shelf steering."
  >
    <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
    <a href={CONTACT.phoneHref} class="btn btn-secondary">Call {CONTACT.phone}</a>
  </QuoteBand>

  <!-- FAQ — the live home FAQ, answers drafted and flagged for review -->
  <section class="reveal bg-[var(--color-surface-alt)] py-16">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl">Frequently asked questions</h2>
      <p class="prose-page mt-3 text-[var(--color-ink-soft)]">
        Please reach us at {CONTACT.email} if you cannot find an answer to your question.
      </p>
      <div class="mt-6">
        <FaqBlock faqs={HOME_FAQ} />
      </div>
    </div>
  </section>

  <!-- Already a customer? Renewal and service path -->
  <section class="reveal container-page py-16">
    <div class="rounded-xl border border-neutral-200 p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl">Already a customer?</h2>
          <p class="mt-2 text-[var(--color-ink-soft)]">
            Renewals, changes and claims go through us, not a national call centre.
            Call or send a message and a person from this team will get back to you.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phone}</a>
          <a href="/contact" class="btn btn-secondary">Contact your team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations — NAP in body copy, not just the footer -->
  <section class="reveal bg-[var(--color-ink)] py-16 text-white">
    <div class="container-page">
      <p class="font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-300)]">
        Visit us
      </p>
      <h2 class="mt-2 text-2xl sm:text-3xl">Two offices, one local team</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {
          LOCATIONS.map((loc) => (
            <div>
              <h3 class="text-lg">
                <a href={`/${loc.slug}`} class="hover:underline hover:text-[var(--color-brand-200)]">
                  {loc.name}
                </a>
              </h3>
              <address class="mt-2 not-italic leading-relaxed text-white/85">
                {loc.street}<br />
                {loc.locality}, {loc.region} {loc.postalCode}
              </address>
            </div>
          ))
        }
      </div>
      <div class="mt-8 border-t border-white/15 pt-6">
        <p class="text-white/85">
          Call <a href={CONTACT.phoneHref} class="font-semibold text-[var(--color-brand-300)]">{CONTACT.phone}</a>
          {' '}· {CONTACT.hours.display}
        </p>
        <a href="/get-a-quote" class="btn btn-on-dark mt-5">Get a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
