---
/**
 * /about — NET NEW. The live site returns a 404 for this path (scope §1).
 *
 * Content is the agency's OWN "Who We Are" copy from evidence/BIG files/Bio.md,
 * with two required corrections (scope §10):
 *   1. The market sentence is normalised to the agreed wording — the file said
 *      "Missouri, Kansas, and beyond" while the homepage said "Kansas" only.
 *   2. Any reference to Blaine is removed. Rodney Roberts appears again as of
 *      6 November 2026, at the client's instruction (scope §2, decision 10).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/SectionBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, LOCATIONS, CONTACT, PHOTOS } from '../config/site.js';
import { TEAM } from '../config/team.js';
import { aboutPageSchema, breadcrumbSchema } from '../lib/schema.js';

const path = '/about';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

/** The team, in the order of src/content/data/team.json (editable in the CMS). */
const team = TEAM;

/** A bio is stored as plain text; a blank line starts a new paragraph. */
const paragraphs = (bio) => bio.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const schema = [
  aboutPageSchema({
    path,
    title: `About ${SITE.name}`,
    description: `Founded in ${SITE.founded} in ${SITE.foundedWhere}, ${SITE.name} is an independent insurance agency. ${SITE.marketStatement}`,
    team,
  }),
  breadcrumbSchema(trail),
];
---

<BaseLayout
  title="About Us | Kansas City Metro | BIG"
  description="Founded in 2018 in Downtown Lee's Summit, Ballentine Insurance Group is an independent agency serving the Kansas City metro across Missouri and Kansas."
  path={path}
  schema={schema}
>
  <Breadcrumbs trail={trail} />

  <SectionBand title="Who we are" kicker="About Ballentine Insurance Group" />

  <article class="container-page py-12">
    <!-- Who we are — the agency's own words, market sentence normalised -->
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_380px]">
    <header class="max-w-3xl">
      <div class="prose-page mt-6 text-[var(--color-ink-soft)]">
        <p>
          Founded in {SITE.founded} by Bret Ballentine in {SITE.foundedWhere},{' '}
          {SITE.name} (BIG) is an independent insurance agency dedicated to protecting
          what matters most. We proudly serve individuals, families, and businesses
          throughout the Kansas City metro area and communities across Missouri and
          Kansas.
        </p>
        <p>
          Our mission is simple: to provide expert guidance, exceptional service, and
          long-term value by helping clients make informed decisions about protecting
          their homes, vehicles, businesses, families, and financial future.
        </p>
        <p>
          Whether you need homeowners, auto, life, commercial, or specialty insurance,
          our experienced team works with multiple top-rated insurance carriers to find
          coverage tailored to your needs and budget. We also offer value-added services
          including Surety Bonds, Estate Planning, Premium Lock, Medicare solutions, and
          supplemental protection options to help clients prepare for every stage of life.
        </p>
        <p>
          At BIG, we believe insurance is more than a policy. It's a relationship built
          on trust, education, and advocacy. From your first quote to every claim and
          renewal, we're committed to being your long-term partner in protection.
        </p>
        <p class="font-semibold text-[var(--color-ink)]">
          Experience the BIG Difference: trusted advice, personalized service, and
          protection you can count on.
        </p>
      </div>
    </header>

    <figure class="lg:sticky lg:top-24">
      <div class="photo-light">
        <img
          src={PHOTOS.teamGroup.src}
          srcset={PHOTOS.teamGroup.srcset}
          sizes="(min-width: 1024px) 380px, 92vw"
          alt={PHOTOS.teamGroup.alt}
          width={PHOTOS.teamGroup.width}
          height={PHOTOS.teamGroup.height}
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
      </div>
      <figcaption class="mt-3 text-sm text-[var(--color-ink-muted)]">
        The team that answers the phone.
      </figcaption>
    </figure>
    </div>

    <!-- Team -->
    <section class="mt-16">
      <h2 class="text-2xl">The team you'll work with</h2>
      <p class="prose-page mt-3 text-[var(--color-ink-soft)]">
        When you call, you reach one of these people — not a call centre.
      </p>

      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          team.map((person) => (
            <article class="team-card card overflow-hidden">
              <div class="team-portrait">
                <img
                  src={person.photo}
                  alt={`${person.name}, ${person.title} at ${SITE.name}`}
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-6">
                <h3 class="text-lg">{person.name}</h3>
                <p class="text-sm font-semibold text-[var(--color-brand-700)]">{person.title}</p>
                <div class="mt-3 space-y-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                  {paragraphs(person.bio).map((p) => <p>{p}</p>)}
                </div>
              </div>
            </article>
          ))
        }
        <aside class="card flex flex-col justify-center bg-[var(--color-surface-alt)] p-6 sm:col-span-2 lg:col-span-1">
          <p class="kicker">Talk to the team</p>
          <p class="mt-3 text-lg font-semibold">One local team, two offices.</p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Call, or start a quote and we will come back to you, usually the same business day.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={CONTACT.phoneHref} class="btn btn-secondary">Call {CONTACT.phone}</a>
            <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Where we are -->
    <section class="mt-16">
      <h2 class="text-2xl">Where to find us</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          LOCATIONS.map((loc) => (
            <div class="rounded-xl bg-[var(--color-surface-alt)] p-6">
              <h3 class="text-lg">
                <a href={`/${loc.slug}`} class="hover:underline hover:text-[var(--color-brand-700)]">
                  {loc.name}
                </a>
              </h3>
              <address class="mt-2 not-italic leading-relaxed text-[var(--color-ink-soft)]">
                {loc.street}<br />
                {loc.locality}, {loc.region} {loc.postalCode}
              </address>
            </div>
          ))
        }
      </div>
      <p class="mt-6">
        Call <a href={CONTACT.phoneHref} class="font-semibold underline">{CONTACT.phone}</a>
        {' '}· {CONTACT.hours.display}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
        <a href="/contact" class="btn btn-secondary">Contact us</a>
      </div>
    </section>
  </article>
</BaseLayout>
