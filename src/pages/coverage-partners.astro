---
/**
 * /coverage-partners — NET NEW, additive.
 *
 * One crawlable index of every specialty programme the agency places through a
 * partner platform, with plain-language disclosure of who does what.
 *
 * WHY: on the live site these eight products exist only as outbound links. That
 * leaves Google and answer engines with no page on insure-big.com explaining the
 * agency's relationship to these programmes — and it leaves a visitor with no idea
 * who they are about to be handed to. This page is both the disclosure surface and
 * the page that earns internal links from all eight specialist pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, absoluteUrl } from '../config/site.js';
import { PARTNERS } from '../config/partners.js';
import { SERVICES, servicePath } from '../config/services.js';
import { webPageSchema, breadcrumbSchema } from '../lib/schema.js';

const path = '/coverage-partners';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Coverage Partners', path },
];

const schema = [
  webPageSchema({
    path,
    title: `Coverage Partners — ${SITE.name}`,
    description: `The specialist insurance programmes ${SITE.name} places through partner platforms, and what each partner's role is.`,
  }),
  breadcrumbSchema(trail),
];

const entries = Object.entries(PARTNERS).map(([slug, p]) => ({ slug, ...p }));
const live = entries.filter((e) => e.shipsLink && e.url);

/**
 * Where the service page actually lives for a partner.
 *
 * ⚠️ NOT every partner product sits under /specialty. Estate planning is a
 * life-insurance line and lives at /life-insurance/estate-planning. Deriving the
 * path from the services config rather than assuming a prefix is what stops this
 * page linking to a URL that does not exist.
 */
function specialistPath(slug) {
  const svc = SERVICES.find((s) => s.slug === slug);
  return svc ? servicePath(svc) : `/specialty/${slug}`;
}

---

<BaseLayout
  title="Coverage Partners | BIG"
  description="The specialist insurance programmes we place through partner platforms — surety bonds, device protection, wind and hail, estate planning and more."
  path={path}
  schema={schema}
>
  <Breadcrumbs trail={trail} />

  <article class="container-page py-12">
    <header class="max-w-3xl">
      <h1 class="text-3xl leading-tight sm:text-4xl">Coverage partners</h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
        Some cover lines are written on specialist platforms rather than directly
        with a carrier. For those, {SITE.name} is still your agency — the partner
        provides the quoting engine, underwriting or administration.
      </p>
      <p class="mt-4 leading-relaxed text-[var(--color-ink-soft)]">
        This page explains who does what for each one, so you know exactly who you
        are dealing with at every step. Where a partner's own application is the
        place cover is completed, we say so plainly.
      </p>
    </header>

    <section class="reveal mt-12">
      <h2 class="text-2xl">Programs</h2>

      <ul class="reveal-stagger mt-8 grid gap-6 md:grid-cols-2">
        {
          live.map((p) => (
            <li class="rounded-xl border border-neutral-200 p-6">
              <h3 class="text-lg">{p.product}</h3>
              {p.programName && p.programName !== p.product && (
                <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{p.programName}</p>
              )}
              {p.highlight && (
                <p class="mt-3 text-sm font-semibold text-[var(--color-brand-700)]">
                  {p.highlight}
                </p>
              )}

              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{p.disclosure}</p>

              <dl class="mt-4 space-y-1 text-sm">
                <div class="flex gap-2">
                  <dt class="font-semibold">Partner:</dt>
                  <dd>{p.partner ?? '—'}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="font-semibold">Your agency:</dt>
                  <dd>{SITE.name}</dd>
                </div>
              </dl>

              <div class="mt-5 flex flex-wrap gap-2">
                <a href={specialistPath(p.slug)} class="btn btn-secondary">
                  About this cover
                </a>
                <a
                  href={p.url}
                  target="_blank"
                  class="btn btn-primary"
                  rel="noopener noreferrer"
                >
                  Learn more at {p.partner}<span class="sr-only"> (leaves this site)</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* Medicare is listed but has no outbound link — the arrangement is unconfirmed
         and the destination is another agency's own site. The page still explains
         the cover and routes to the on-site form. */
    }

    <section class="reveal mt-12 rounded-xl bg-[var(--color-surface-alt)] p-6">
      <h2 class="text-xl">How our partner links work</h2>
      <ul class="prose-page mt-4 space-y-3 text-[var(--color-ink-soft)]">
        <li>
          <strong>Your first step is always here.</strong> Every specialty page has our
          own form. Completing it puts you in our pipeline with your consent recorded
          — it does not commit you to anything.
        </li>
        <li>
          <strong>Partner links are labelled.</strong> Where we send you to a partner's
          own application, we tell you before you click, because it is a different
          website with its own privacy policy.
        </li>
        <li>
          <strong>We tell you who owns the relationship.</strong> Where a partner's
          programme carries our appointment, we say so. Where it does not, we say that
          too — completing a third-party application does not by itself make us your
          agent of record.
        </li>
        <li>
          <strong>We are paid for referrals.</strong> Some partner programmes pay us a
          referral fee or commission. This does not change what you pay, and it does
          not change our advice — but you should know it.
        </li>
      </ul>
    </section>

    <section class="reveal mt-12">
      <h2 class="text-2xl">Not sure which you need?</h2>
      <p class="prose-page mt-3 leading-relaxed text-[var(--color-ink-soft)]">
        Call us on
        {' '}
        <a href="tel:+18168681787" class="font-semibold underline">(816) 868-1787</a>
        {' '}and we will tell you honestly whether you need one of these programmes, a
        standard policy, or nothing at all.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-secondary">Contact us</a>
        <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>
  </article>
</BaseLayout>
