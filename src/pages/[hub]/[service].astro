---
/**
 * Service pages nested under the three indexed hubs.
 *   /personal-insurance/{slug}   /business-insurance/{slug}   /life-insurance/{slug}
 *
 * website-scope.md §4. Every one of these URLs is NEW, so there is no redirect
 * risk — but each carries a self-referencing canonical and the FAQ, Service and
 * Breadcrumb nodes that make it machine-readable (§5.2).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceForm from '../../components/ServiceForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import CarrierStrip from '../../components/CarrierStrip.astro';
import RelatedCoverage from '../../components/RelatedCoverage.astro';
import { partnerFor } from '../../config/partners.js';
import { SPECIALTY_EXPLAINERS } from '../../config/specialty-explainers.js';
import { HUBS, SERVICES, servicePath } from '../../config/services.js';
import { SERVICE_CARRIERS } from '../../config/carriers.js';
import { QUOTE_URL, LOCATIONS } from '../../config/site.js';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../lib/schema.js';

export function getStaticPaths() {
  return SERVICES.filter((s) => s.hub !== 'specialty').map((service) => {
    const hub = HUBS.find((h) => h.slug === service.hub);
    return {
      params: { hub: service.hub, service: service.slug },
      props: { service, hub },
    };
  });
}

const { service, hub } = Astro.props;
const path = servicePath(service);

/**
 * Some hub lines are also placed through a partner platform — estate planning is
 * a life-insurance line written via FastWill, for example. So the partner block
 * belongs here as well as on /specialty pages.
 *
 * ⚠️ The ON-SITE FORM IS ALWAYS THE PRIMARY CTA. See src/config/partners.js.
 */
const partner = partnerFor(service.slug);
const showPartnerLink = Boolean(partner?.shipsLink && partner?.url);

/** Original explanatory copy where a partner places the line (W3). */
const explainer = SPECIALTY_EXPLAINERS[service.slug] ?? [];
const carriers = SERVICE_CARRIERS[service.hub] ?? [];

const trail = [
  { name: 'Home', path: '/' },
  { name: hub.title, path: `/${hub.slug}` },
  { name: service.name, path },
];

const schema = [
  serviceSchema({ name: service.name, description: service.metaDescription, path }),
  faqSchema({ faqs: service.faq, path }),
  breadcrumbSchema(trail),
].filter(Boolean);
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  path={path}
  schema={schema}
>
  <Breadcrumbs trail={trail} />

  <article class="container-page py-10 lg:py-14">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_380px]">
      <!-- Main column -->
      <div>
        <header>
          <p class="kicker">
            {hub.title}
          </p>
          <h1 class="mt-3 text-3xl leading-tight tracking-tight sm:text-4xl">{service.h1}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
            {service.blurb}
          </p>
          <p class="mt-4 text-sm font-semibold">{service.searchIntent.replace(/^./, (c) => c.toUpperCase())} — serving the Kansas City metro and communities throughout Missouri and Kansas.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={QUOTE_URL} class="btn btn-primary">Get a quote</a>
            <a href="/contact" class="btn btn-secondary">Talk to a person</a>
          </div>
        </header>

        <div class="prose-page prose-checks mt-10">
          <h2>What this coverage includes</h2>
          <ul>
            {service.covers.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {
          /* ORIGINAL explanatory content (W3) — applies to the life-hub lines
             (estate planning, Medicare) that are placed with a partner. */
          explainer?.length > 0 && (
            <div class="prose-page mt-10">
              <h2>Understanding {service.name.toLowerCase()}</h2>
              {explainer.map((para) => <p>{para}</p>)}
            </div>
          )
        }

        {
          service.faq?.length ? (
            <FaqBlock faqs={service.faq} />
          ) : null
        }

        {
          carriers.length ? (
            <section class="mt-14">
              <h2 class="text-2xl">Carriers we place this with</h2>
              <p class="prose-page mt-3 text-[var(--color-ink-soft)]">
                We are an independent agency, so we compare rather than steer. These
                are the carriers we most often place this line with.
              </p>
              <CarrierStrip slugs={carriers} />
            </section>
          ) : null
        }

        <section class="mt-14 rounded-2xl bg-[var(--color-surface-alt)] p-6">
          <h2 class="text-xl">Why work with an independent agency</h2>
          <ul class="prose-page mt-4 space-y-3 text-[var(--color-ink-soft)]">
            <li>We are not tied to a single carrier, so we can compare rather than steer.</li>
            <li>One local team handles the quote, the policy and the claim.</li>
            <li>We review your cover annually, so it keeps pace as your circumstances change.</li>
          </ul>
          <p class="mt-6">
            <a href="/about" class="font-semibold underline">More about Ballentine Insurance Group</a>
          </p>
        </section>

        <RelatedCoverage current={service.slug} hub={service.hub} />
      </div>

      <!-- Sidebar: the form, sticky on desktop so it is always one click away -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <ServiceForm
          form={service.form ?? 'personal'}
          path={path}
          label={service.name.replace(/ Insurance$/i, '').toLowerCase()}
        />

        <div class="mt-6 rounded-xl border border-neutral-200 p-5 text-sm">
          <h2 class="text-base font-bold">Talk to a person</h2>
          <p class="mt-2 text-[var(--color-ink-soft)]">
            Two offices, one team — Lee's Summit and the Kansas City Northland.
          </p>
          <address class="mt-3 not-italic leading-relaxed text-[var(--color-ink-soft)]">
            {LOCATIONS[0].street}<br />{LOCATIONS[0].locality}, {LOCATIONS[0].region} {LOCATIONS[0].postalCode}
          </address>
          <address class="mt-3 not-italic leading-relaxed text-[var(--color-ink-soft)]">
            {LOCATIONS[1].street}<br />{LOCATIONS[1].locality}, {LOCATIONS[1].region} {LOCATIONS[1].postalCode}
          </address>
          <p class="mt-3">
            <a href="tel:+18168681787" class="font-semibold underline">(816) 868-1787</a><br />
            <span class="text-[var(--color-ink-muted)]">Monday – Friday, 9:00am – 5:00pm</span>
          </p>
        </div>

        {
          /* Partner block for hub lines that are placed through a partner platform
             (estate planning via FastWill). Only rendered when a link is approved —
             the form above remains the primary call to action. */
          partner && showPartnerLink && (
            <div class="mt-6 rounded-xl border border-neutral-200 p-5 text-sm">
              <h2 class="text-base font-bold">Prefer {partner.partner}?</h2>
              <p class="mt-2 leading-relaxed text-[var(--color-ink-soft)]">{partner.disclosure}</p>
              {partner.highlight && (
                <p class="mt-3 text-sm font-semibold text-[var(--color-brand-700)]">
                  {partner.highlight}
                </p>
              )}
              <a
                href={partner.url}
                class="btn btn-secondary mt-4 w-full"
                target="_blank"
                rel="noopener noreferrer"
              >
                Learn more at {partner.partner}
                <span class="sr-only">(opens {partner.partner}'s website in a new tab)</span>
              </a>
              <p class="mt-3 text-xs text-[var(--color-ink-muted)]">
                <a href="/coverage-partners" class="underline">
                  How our partner programmes work
                </a>
              </p>
            </div>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>
