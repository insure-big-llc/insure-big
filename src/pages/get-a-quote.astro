---
/**
 * /get-a-quote
 *
 * 🔴 INDEXED URL, must stay at exactly this path (website-scope.md §4).
 *
 * The one place a quote is requested. Every service, hub, office and contact page
 * links here with the type and the line already chosen (?type=&line=&from=), and
 * the form (src/components/QuoteForm.astro) posts to /api/lead. Partner product
 * pages do not come here: their button goes to the partner's referral link.
 *
 * The live page had three headings that all read "Step 2". This keeps the
 * corrected three step explanation, now beside the form instead of above it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { CONTACT } from '../config/site.js';
import { webPageSchema, breadcrumbSchema } from '../lib/schema.js';

const path = '/get-a-quote';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Get a Quote', path },
];

const steps = [
  {
    n: 1,
    title: 'Tell us what you need',
    body: 'Choose personal or business, then pick the cover you are after. It takes about two minutes.',
  },
  {
    n: 2,
    title: 'Share the details',
    body: 'A few questions about what you are protecting, from your home and vehicles to your operations.',
  },
  {
    n: 3,
    title: 'Get your quote',
    body: 'A licensed agent compares options across multiple carriers and comes back with a recommendation, not just a price.',
  },
];

const schema = [
  webPageSchema({
    path,
    title: 'Get an Insurance Quote',
    description:
      'Start a personal, business or life insurance quote with Ballentine Insurance Group, serving the Kansas City metro.',
  }),
  breadcrumbSchema(trail),
];
---

<BaseLayout
  title="Get an Insurance Quote | Kansas City | BIG"
  description="Start a personal, business or life insurance quote with Ballentine Insurance Group. Serving the Kansas City metro and communities throughout Missouri and Kansas."
  path={path}
  schema={schema}
  hideCallBar
>
  <Breadcrumbs trail={trail} />

  <section class="container-page py-12">
    <header class="max-w-3xl">
      <h1 class="text-3xl leading-tight sm:text-4xl">Start your quote the BIG way</h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
        Tell us what you need and a licensed agent will compare options across multiple
        carriers and come back to you with a recommendation, not just a price.
      </p>
    </header>

    <div class="mt-10 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="card p-6 sm:p-8">
        <QuoteForm />
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <section class="card p-6">
          <h2 class="text-lg">What happens next</h2>
          <ol class="mt-4 space-y-4">
            {
              steps.map((s) => (
                <li class="flex gap-3">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-500)] text-sm font-bold">
                    {s.n}
                  </span>
                  <span>
                    <span class="block font-semibold">{s.title}</span>
                    <span class="mt-0.5 block text-sm leading-relaxed text-[var(--color-ink-soft)]">{s.body}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="rounded-xl bg-[var(--color-surface-alt)] p-6">
          <h2 class="text-lg">Would you rather just talk?</h2>
          <p class="mt-2 text-[var(--color-ink-soft)]">
            Call <a href={CONTACT.phoneHref} class="font-semibold underline">{CONTACT.phone}</a>
            {' '}during {CONTACT.hours.display}, or{' '}
            <a href="/contact" class="font-semibold underline">see both office locations</a>.
          </p>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
