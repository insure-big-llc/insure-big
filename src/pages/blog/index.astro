---
/**
 * /blog — the content engine index. Spec 0004.
 *
 * Lists published posts, newest first. Drafts stay out. The friendly empty
 * state keeps the page and its Blog schema alive before the first post.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedPosts, getBlogPosts } from '../../lib/blog-posts.js';
import { SITE } from '../../config/site.js';
import { webPageSchema, breadcrumbSchema } from '../../lib/schema.js';

const path = '/blog';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];

const { errors } = getBlogPosts();
if (errors.length) {
  throw new Error(`Blog content errors:\n- ${errors.join('\n- ')}`);
}

const posts = publishedPosts();

const schema = [
  webPageSchema({
    path,
    title: 'Insurance Answers & Updates',
    description:
      'Plain answers to the insurance questions Kansas City families ask, plus agency news and practical ways to save on your coverage.',
  }),
  breadcrumbSchema(trail),
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/blog#blog`,
    name: `${SITE.name} blog`,
    url: `${SITE.url}/blog`,
    inLanguage: 'en-US',
  },
];
---

<BaseLayout
  title="Insurance Answers & Updates | Kansas City | BIG"
  description="Plain answers to the insurance questions Kansas City families ask, plus agency news and practical ways to save on your coverage."
  path={path}
  schema={schema}
>
  <Breadcrumbs trail={trail} />

  <article class="container-page py-12">
    <header class="max-w-3xl">
      <p class="font-[var(--font-heading)] text-sm font-bold uppercase tracking-widest text-[var(--color-brand-700)]">
        The BIG blog
      </p>
      <h1 class="mt-3 text-3xl leading-tight sm:text-4xl">Insurance answers, in plain words</h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
        One short read per question, written by the people who answer the phones.
        If you cannot find your question, call us and we will answer it directly.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <section class="mt-12 rounded-xl bg-[var(--color-surface-alt)] p-8 text-center">
          <h2 class="text-xl">First posts are coming</h2>
          <p class="prose-page mx-auto mt-3 max-w-2xl text-[var(--color-ink-soft)]">
            We are writing up the questions we hear most often. Check back soon,
            or call (816) 868-1787 and ask us anything now.
          </p>
        </section>
      ) : (
        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {
            posts.map((p) => (
              <li class="group flex flex-col rounded-xl border border-neutral-200 p-6 transition-all hover:-translate-y-0.5 hover:border-[var(--color-brand-400)] hover:shadow-lg">
                {p.cover && (
                  <img
                    src={p.cover}
                    alt=""
                    width="1200"
                    height="630"
                    loading="lazy"
                    class="mb-4 h-40 w-full rounded-lg object-cover"
                  />
                )}
                <h2 class="text-xl">
                  <a href={`/blog/${p.slug}`} class="hover:underline hover:text-[var(--color-brand-700)]">
                    {p.title}
                  </a>
                </h2>
                <p class="mt-1 text-xs text-[var(--color-ink-muted)]">
                  {p.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                  {p.description}
                </p>
                <p class="mt-auto pt-5 text-sm font-semibold text-[var(--color-brand-700)]">
                  <a href={`/blog/${p.slug}`} class="inline-flex items-center gap-1 hover:underline">
                    Read the answer <span aria-hidden="true">→</span>
                  </a>
                </p>
              </li>
            ))
          }
        </ul>
      )
    }
  </article>
</BaseLayout>
