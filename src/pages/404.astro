---
/**
 * 404 page.
 *
 * 🔴 website-scope.md §4: the current GoDaddy 404 renders a "Page Not Found"
 * body while returning HTTP 200 — a soft 404. It is also the one path the live
 * robots.txt disallows (`Disallow: /404`), which is why Google never sees the
 * real status either way.
 *
 * Astro's static build emits this as `dist/404.html`, and Netlify/Nginx/Cloudflare
 * serve it with a genuine 404 status. That is what we want: a real 404.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/SectionBand.astro';
import { HUBS, SERVICES } from '../config/services.js';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist. Browse our insurance coverage or contact Ballentine Insurance Group."
  path="/404"
  noindex={true}
>
  <SectionBand title="We couldn't find that page" kicker="Error 404" />

  <section class="container-page py-12">
    <p class="prose-page mt-4 text-[var(--color-ink-soft)]">
      The page you were looking for may have moved or never existed. Here is where
      most people are heading:
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        HUBS.map((hub) => (
          <div>
            <h2 class="text-lg font-bold">
              <a href={`/${hub.slug}`} class="hover:underline hover:text-[var(--color-brand-700)]">
                {hub.title}
              </a>
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {SERVICES.filter((s) => s.hub === hub.slug)
                .slice(0, 5)
                .map((s) => (
                  <li>
                    <a href={`/${hub.slug}/${s.slug}`} class="text-[var(--color-ink-soft)] hover:underline hover:text-[var(--color-brand-700)]">
                      {s.name}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <a href="/" class="btn btn-secondary">Back to home</a>
      <a href="/get-a-quote" class="btn btn-primary">Get a quote</a>
      <a href="/contact" class="btn btn-secondary">Contact us</a>
    </div>
  </section>
</BaseLayout>
